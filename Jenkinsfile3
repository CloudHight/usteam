pipeline {
    agent any
    stages {
//        stage('Code Checkout') {
//            steps {
//                git branch: 'main',
//                credentialsId: 'git-cred',
//                url: 'https://github.com/CloudHight/usteam.git'
//            }
//        }
        stage('Code Analysis') {
            steps {
               withSonarQubeEnv('sonarqube') {
                  sh "mvn sonar:sonar"
               }
            }
        }
        stage("Quality Gate") {
            steps {
              timeout(time: 2, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true
              }
            }
        }
          stage('Dependency check') {
              steps {
                  withCredentials([string(credentialsId: 'nvd-key', variable: 'NVD_API_KEY')]) {
                      dependencyCheck additionalArguments: "--scan ./ --disableYarnAudit --disableNodeAudit --nvdApiKey $NVD_API_KEY", 
                          odcInstallation: 'DP-Check'
                  }
                  dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
              }
          }
           stage('Build Artifact') {
                steps {
                    sh 'mvn clean package -DskipTests -Dcheckstyle.skip'
                }
            }
    
            stage('Push Artifact to Nexus Repo') {
                steps {
                    nexusArtifactUploader artifacts: [[
                        artifactId: 'spring-petclinic',
                        classifier: '',
                        file: 'target/spring-petclinic-2.4.2.war',
                        type: 'war'
                    ]],
                    credentialsId: 'nexus-cred',
                    groupId: 'Petclinic',
                    nexusUrl: 'nexus.everythingops.io',
                    nexusVersion: 'nexus3',
                    protocol: 'https',
                    repository: 'nexus-repo',
                    version: '1.0'
                }
            }
            stage('Build Docker Image') {
                steps {
                    sh 'docker build -t 35.180.110.36:8085/petclinicapps:latest .'
            }
        }
            stage('Login to Nexus Docker Repo') {
                steps {
                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh '''
                            echo "$DOCKER_PASS" | docker login 35.180.110.36:8085 \
                            --username "$DOCKER_USER" --password-stdin
                        '''
                    }
                }
            } 
            stage('Trivy Image Scan') {
                steps {
                    sh 'trivy image --insecure -f table 35.180.110.36:8085/petclinicapps:latest'
                }
            }
    
            stage('Push to Nexus Docker Repo') {
                steps {
                    sh 'docker push 35.180.110.36:8085/petclinicapps:latest'
                }
            }
    
            stage('Prune Docker Images') {
                steps {
                    sh 'docker image prune -f'
                }
            }
            // ------------------- STAGE DEPLOY -------------------
           stage('Deploy to Stage Environment') {
                steps {
                    script {
                        try {
                            withCredentials([
                                string(credentialsId: 'bastion-id', variable: 'BASTION_ID'),
                                string(credentialsId: 'ansible-ip', variable: 'ANSIBLE_IP')
                            ]) {
            
                                sh '''
                                aws ssm send-command \
                                  --instance-ids $BASTION_ID \
                                  --region eu-west-3 \
                                  --document-name "AWS-RunShellScript" \
                                  --comment "Deploy via Bastion to Ansible" \
                                  --parameters 'commands=[
                                    "ssh -o StrictHostKeyChecking=no ec2-user@$ANSIBLE_IP sudo /usr/bin/ansible-playbook -i /ansible/stage_hosts /ansible/deployment.yml"
                                  ]' \
                                  --output text
                                '''
            
                            }
                        } catch (Exception e) {
                            error("Deployment failed: ${e.message}")
                        }
                    }
                }
            }
            stage('check website availability') {
                steps {
                     sh "sleep 90"
                     sh "curl -s -o /dev/null -w \"%{http_code}\" https://stage-app.everythingops.io/"
                    script {
                        def response = sh(script: "curl -s -o /dev/null -w \"%{http_code}\" https://stage-app.everythingops.io/", returnStdout: true).trim()
                        if (response == "200") {
                            slackSend(color: 'good', message: "The stage petclinic java application is up and running with HTTP status code ${response}.", tokenCredentialId: 'slack-cred')
                        } else {
                            slackSend(color: 'danger', message: "The stage petclinic java application appears to be down with HTTP status code ${response}.", tokenCredentialId: 'slack-cred')
                        }
                    }
                }
            }
            stage('DAST Scan (OWASP ZAP)') {
                steps {
                    script {
                        def zapStatus = sh(
                            script: '''
                                docker run --rm -v $WORKSPACE:/zap/wrk/:rw -t ghcr.io/zaproxy/zaproxy:stable \
                                  zap-baseline.py -t https://stage-app.everythingops.io/ \
                                  -r zap-report.html -J zap-report.json
                            ''',
                            returnStatus: true
                        )
                        archiveArtifacts artifacts: 'zap-report.html,zap-report.json', allowEmptyArchive: true
                        // zap-baseline.py exits non-zero on WARN/FAIL alerts as well as scan
                        // errors; treat it as informational (like the other scan stages above)
                        // rather than aborting the promotion to prod.
                        if (zapStatus != 0) {
                            slackSend(color: 'warning', message: "OWASP ZAP baseline scan on stage-app.everythingops.io flagged issues (exit ${zapStatus}) - review zap-report.html on build ${env.BUILD_URL}.", tokenCredentialId: 'slack-cred')
                        } else {
                            slackSend(color: 'good', message: "OWASP ZAP baseline scan on stage-app.everythingops.io passed with no alerts.", tokenCredentialId: 'slack-cred')
                        }
                    }
                }
            }
            stage('Request for Approval') {
                steps {
                    timeout(activity: true, time: 10) {
                        input message: 'Needs Approval ', submitter: 'admin'
                    }
                }
            }
            // ------------------- PROD DEPLOY -------------------
            stage('Deploy to Prod Environment') {
                steps {
                    script {
                        try {
                            withCredentials([
                                string(credentialsId: 'bastion-id', variable: 'BASTION_ID'),
                                string(credentialsId: 'ansible-ip', variable: 'ANSIBLE_IP')
                            ]) {
            
                                sh '''
                                aws ssm send-command \
                                  --instance-ids $BASTION_ID \
                                  --region eu-west-3 \
                                  --document-name "AWS-RunShellScript" \
                                  --comment "Deploy via Bastion to Ansible" \
                                  --parameters 'commands=[
                                    "ssh -o StrictHostKeyChecking=no ec2-user@$ANSIBLE_IP sudo /usr/bin/ansible-playbook -i /ansible/prod_hosts /ansible/deployment.yml"
                                  ]' \
                                  --output text
                                '''
            
                            }
                        } catch (Exception e) {
                            error("Deployment failed: ${e.message}")
                        }
                    }
                }
            }
            
            stage('Check Prod Website') {
                steps {
                    sleep 90
                    script {
                        def response = sh(script: "curl -s -o /dev/null -w \"%{http_code}\" https://app.everythingops.io", returnStdout: true).trim()
                        if (response == "200") {
                            slackSend(color: 'good', message: "Prod app is UP (${response})", tokenCredentialId: 'slack-cred')
                        } else {
                            slackSend(color: 'danger', message: "Prod app is DOWN (${response})", tokenCredentialId: 'slack-cred')
                        }
                    }
                }
            }
    }

}
